# Copy to .env and fill in. Never commit .env.

# --- n8n ---------------------------------------------------------------
# n8n image tag. Workflows were built and tested on 2.47.3.
N8N_VERSION=2.47.3
# Port on your machine where the n8n editor opens (http://localhost:5678).
N8N_PORT=5678
# Long random string that encrypts saved credentials.
# Generate once (e.g. `openssl rand -hex 32`) and NEVER change it afterwards.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Public base URL of n8n. Used in webhook URLs and in error-alert execution links.
WEBHOOK_URL=http://localhost:5678/
# Clinic timezone. Schedules (09:00 reminders, 20:00 summary) run in this zone.
TZ=Africa/Cairo

# --- Clinic ------------------------------------------------------------
CLINIC_NAME=Bright Smile Dental Clinic

# --- Webhook security --------------------------------------------------
# Callers of POST /webhook/clinic-intake must send header  X-Clinic-Secret: <this value>
WEBHOOK_SECRET=change-me-to-a-random-secret

# --- Google Gemini (AI) -------------------------------------------------
# Free key: aistudio.google.com/apikey
GEMINI_API_KEY=
# Fast, cheap model used to understand messages (free tier available).
GEMINI_MODEL=gemini-flash-lite-latest

# --- Google Sheets (Service Account) -----------------------------------
# The ID is the long part of the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
# The service-account JSON key must be saved as secrets/google-service-account.json

# --- Email (Gmail SMTP) ------------------------------------------------
# Gmail address that sends patient emails
SMTP_USER=yourclinic@gmail.com
# 16-character Google App Password (not your normal Gmail password)
SMTP_PASS=
# Display name patients see
SMTP_FROM_NAME=Bright Smile Dental Clinic

# --- Telegram ----------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:your-bot-token
# Chat that receives clinic notifications (bookings, urgent alerts, daily summary)
TELEGRAM_CHAT_ID=your-chat-id
# Chat that receives technical error alerts (can be the same as above)
TELEGRAM_ADMIN_CHAT_ID=your-chat-id
